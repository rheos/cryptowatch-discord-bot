# MySQL Configuration for 1GB Lightsail Instance
# Place this in /etc/mysql/mysql.conf.d/optimization.cnf

[mysqld]
# Reduce memory and CPU usage
innodb_buffer_pool_size = 128M    # Down from default 128M or more
innodb_log_file_size = 48M        # Smaller log files
innodb_flush_method = O_DIRECT    # Reduce double buffering

# Reduce CPU usage from queries
innodb_thread_concurrency = 2     # Match your vCPU count
innodb_read_io_threads = 2
innodb_write_io_threads = 2

# Connection limits
max_connections = 25              # Lower from default 151
thread_cache_size = 8             # Cache threads to reduce CPU

# Query cache (helps repeated queries)
query_cache_type = 1
query_cache_size = 16M
query_cache_limit = 1M

# Reduce sorting/joining CPU usage  
sort_buffer_size = 256K
join_buffer_size = 256K
read_buffer_size = 128K
read_rnd_buffer_size = 256K

# Disable performance schema to save CPU
performance_schema = OFF

# Slow query logging (find problem queries)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# Other optimizations
skip-name-resolve                 # Don't resolve hostnames
innodb_stats_on_metadata = 0      # Don't update stats on metadata queries